# Copy to .env. Everything here is optional: agent mode (Claude Code / Cowork / Codex / Kimi Code) needs no keys.

# ---- Standalone mode (`digest run`): any OpenAI-compatible chat endpoint ----
# LLM_MODEL is the provider's model name (see its catalogue).
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1      (also gives access to Claude, Gemini, Qwen…)
# Kimi:        LLM_BASE_URL=https://api.moonshot.ai/v1
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1
# Local:       LLM_BASE_URL=http://localhost:11434/v1          (Ollama, vLLM, LM Studio)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# set to 0 if the endpoint rejects response_format=json_object
LLM_JSON_MODE=1

# ---- Embeddings (optional, improves story matching on long horizons) ----
# Any OpenAI-compatible /embeddings. Without it, built-in hashed word-stem vectors are used.
# e.g. EMBED_BASE_URL=https://api.openai.com/v1 with an embedding model name in EMBED_MODEL
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ---- E-mail delivery (SMTP) and feedback replies (IMAP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# where 👍/👎 links and replies go (default: SMTP_FROM)
FEEDBACK_EMAIL=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---- Telegram bot (delivery + feedback by replying to the bot) ----
TELEGRAM_BOT_TOKEN=

# ---- Memory for clean-copy runs (cloud agents, CI): snapshot of state/ + digests/ in a PRIVATE git repo ----
# DIGEST_STATE_GIT=git@github.com:you/my-digest-state.git
# DIGEST_STATE_BRANCH=digest-state
# DIGEST_STATE_PASSPHRASE=          # optional: encrypt the snapshot (needs the openssl CLI)

# ---- Paths ----
# DIGEST_HOME=/path/to/folder   (default: current directory; holds digests/, state/, out/)
# DIGEST_DB=/path/to/digest.db  (put the memory somewhere persistent / synced)
